{
  "$defs": {
    "ScheduleBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "kind": {
          "enum": [
            "study",
            "fixed",
            "sleep_protected",
            "sleep_extension",
            "break"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "start",
        "end",
        "block_id",
        "kind"
      ],
      "title": "ScheduleBlock",
      "type": "object"
    },
    "UnscheduledWork": {
      "additionalProperties": false,
      "properties": {
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "minutes": {
          "exclusiveMinimum": 0,
          "title": "Minutes",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "minutes",
        "deadline",
        "reason"
      ],
      "title": "UnscheduledWork",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/ScheduleBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "schedule_version": {
      "title": "Schedule Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unscheduled_work": {
      "items": {
        "$ref": "#/$defs/UnscheduledWork"
      },
      "title": "Unscheduled Work",
      "type": "array"
    }
  },
  "required": [
    "schedule_version",
    "blocks"
  ],
  "title": "Schedule",
  "type": "object"
}
