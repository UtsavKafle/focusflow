# Names only. Never commit real values. Copy to .env and fill in.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_CATALOG=focusflow
DATABRICKS_SCHEMA=main
DATABRICKS_VOLUME_PATH=/Volumes/focusflow/main/landing
# Optional: model/agent endpoint (unconfirmed). Leave blank to use the Anthropic/OpenAI fallback below.
DATABRICKS_MODEL_ENDPOINT=
LLM_API_KEY=
# Backend
FOCUSFLOW_DATA_SOURCE=fixture   # fixture | databricks
FOCUSFLOW_FIXTURE=trigger       # normal | trigger | missing_data | infeasible
FOCUSFLOW_DB_PATH=./focusflow.sqlite
FOCUSFLOW_AUTO_APPLY=0          # 1 = demo auto-apply of valid proposals (manual Apply is default)
FOCUSFLOW_RUN_ID=               # databricks mode: Gold run_id to read (blank = latest)
FOCUSFLOW_REPLAY_MODE=live      # live | saved (feature replay)
AGENT_MAX_TOOL_CALLS=8
AGENT_TIME_CAP_S=60
