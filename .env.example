# Names only. Never commit real values. Copy to .env and fill in.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_CATALOG=focusflow
DATABRICKS_SCHEMA=main
DATABRICKS_VOLUME_PATH=/Volumes/focusflow/main/landing
# Optional: model/agent endpoint (unconfirmed). Leave blank to use the Anthropic/OpenAI fallback below.
DATABRICKS_MODEL_ENDPOINT=
LLM_API_KEY=
# Backend
FOCUSFLOW_DATA_SOURCE=fixture   # fixture | databricks
FOCUSFLOW_FIXTURE=trigger       # normal | trigger | missing_data | infeasible
FOCUSFLOW_DB_PATH=./focusflow.sqlite
FOCUSFLOW_CORS_ORIGINS=         # only if the UI is not behind the Vite proxy, e.g. http://localhost:4173
FOCUSFLOW_AUTO_APPLY=0          # 1 = demo auto-apply of valid proposals (manual Apply is default)
FOCUSFLOW_RUN_ID=               # databricks mode: Gold run_id to read, e.g. mock-demo-002 (blank = newest row of any run)
FOCUSFLOW_REPLAY_MODE=live      # live | saved (feature replay)
# Live replay control (task 7): set RAW_DIR to drive Data A's ReplayController from /api/replay/*.
# Blank = Gold read-only: the backend runs its own replay clock from SCENARIO_START + HISTORY_HOURS (or the UI bookmark)
# and only reads Gold rows with as_of <= clock. Values below are Data A's mock-demo settings (synthetic participant 001).
FOCUSFLOW_REPLAY_RAW_DIR=                       # e.g. data/raw/001
FOCUSFLOW_REPLAY_SOURCE_START=2020-02-13T12:00:00-05:00
FOCUSFLOW_REPLAY_SCENARIO_START=2026-10-09T12:00:00-04:00
FOCUSFLOW_REPLAY_SOURCE_TZ=America/New_York
FOCUSFLOW_REPLAY_SHIFT_DAYS=2430
FOCUSFLOW_REPLAY_SOURCE_KIND=synthetic_fixture  # mock CSVs are synthetic; never label them recorded_replay
FOCUSFLOW_REPLAY_HISTORY_HOURS=48               # default bookmark = scenario start + history hours
FOCUSFLOW_REPLAY_DEMO_HOURS=36
FOCUSFLOW_REPLAY_BATCH_SIZE=100000
AGENT_MAX_TOOL_CALLS=8
AGENT_TIME_CAP_S=60
